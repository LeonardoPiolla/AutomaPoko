<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema base — usado pelo Compose, sem barra de título -->
    <style name="Theme.AutomaPoko" parent="android:Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">#0F0F0F</item>
        <item name="android:navigationBarColor">#0F0F0F</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Tema da SplashScreen — windowSplashScreenBrandingImage requer API 31+ -->
    <style name="Theme.AutomaPoko.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0F0F0F</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.AutomaPoko</item>
    </style>
</resources>
