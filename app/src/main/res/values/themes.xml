<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AutomaPoko" parent="android:Theme.Material.NoTitleBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">#0F0F0F</item>
        <item name="android:navigationBarColor">#0F0F0F</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.AutomaPoko.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0F0F0F</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenBrandingImage">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.AutomaPoko</item>
    </style>
</resources>
