<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===================== BLUETOOTH ===================== -->
    <!-- Necessário para listar dispositivos pareados e monitorar conexões -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- Android 12+ -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />

    <!-- ===================== WI-FI ===================== -->
    <!-- Necessário para ler SSID da rede e escanear redes disponíveis -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- ===================== LOCALIZAÇÃO ===================== -->
    <!-- Necessário para Geofencing e leitura de SSID Wi-Fi -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Necessário para Geofencing funcionar com o app fechado -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- ===================== REDE ===================== -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ===================== EXECUÇÃO EM BACKGROUND ===================== -->
    <!-- Reativar automações após reinicialização do dispositivo -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Isentar da otimização de bateria (solicitado via dialog) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Abrir aplicativos a partir do background (solicitado via Settings) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Foreground Service para execução de ações -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- ===================== NOTIFICAÇÕES ===================== -->
    <!-- Android 13+ — necessário para notificações de diagnóstico/erro -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ===================== SCHEDULE ===================== -->
    <!-- WorkManager -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:targetApi="31" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <application
        android:name=".AutomaPokoApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.AutomaPoko"
        tools:targetApi="31">

        <!-- Activity principal -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AutomaPoko.SplashScreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ===================== RECEIVERS ===================== -->

        <!-- Receiver: Bluetooth — escuta conexão e desconexão de dispositivos -->
        <receiver
            android:name=".receivers.BluetoothTriggerReceiver"
            android:exported="true"
            android:permission="android.permission.BLUETOOTH_CONNECT">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <!-- Receiver: Wi-Fi — escuta mudanças de conectividade de rede -->
        <receiver
            android:name=".receivers.WifiTriggerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
                <action android:name="android.net.wifi.STATE_CHANGE" />
            </intent-filter>
        </receiver>

        <!-- Receiver: Geofencing — recebe eventos de entrada/saída de área -->
        <receiver
            android:name=".receivers.GeofencingTriggerReceiver"
            android:exported="true" />

        <!-- Receiver: Boot — reregistra geofences e listeners após reinicialização -->
        <receiver
            android:name=".receivers.BootReceiver"
            android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <!-- HyperOS/MIUI -->
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Provider: FileProvider para compatibilidade futura -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

            <!-- Google Maps API Key (necessária para o mapa de localização) -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

    </application>

</manifest>
